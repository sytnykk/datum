{
  "name": "datum",
  "version": "0.1.0",
  "description": "Datum design system: Figma variables to W3C tokens to CSS and Tailwind, with a live docs site.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "dev": "vite",
    "build": "npm run tokens:check && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.5.0",
    "geist": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "private": true,
  "type": "module"
}
